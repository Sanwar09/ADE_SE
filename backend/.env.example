# ──── ADT-SE Configuration ────

# Gemini API Key (required) — get from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Additional API keys for rotation (optional — prevents rate limiting)
# GEMINI_API_KEY_2=your_second_key_here
# GEMINI_API_KEY_3=your_third_key_here

# Model selection
MODEL_NAME=gemini-2.0-flash

# Rate limiting (seconds between API calls, increase if hitting 429 errors)
LLM_MIN_INTERVAL_SEC=4

# Response caching (set to false to disable)
LLM_CACHE_ENABLED=true

# Server
PORT=8000
HOST=0.0.0.0

# ──── GitHub Integration (OPTIONAL) ────
# Set this ONLY if you want push/PR features
# Get from: GitHub → Settings → Developer Settings → Personal Access Tokens
# GITHUB_TOKEN=your_github_token_here
